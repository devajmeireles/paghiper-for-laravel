includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src/

    level: 5

    # composer.json allows php ^8.0, but the code needs 8.1 (enums, readonly).
    phpVersion: 80100

    ignoreErrors:
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id#'
            path: src/Actions/Billet/CreateBillet.php

        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id#'
            path: src/Actions/Pix/CreatePix.php
